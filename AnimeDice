PrestineLib:AddHybrid({
    Tab = "Units",
    MainTitle = "Auto Sell Units",
    Description = "Sells units matching the selected names or rarities",
    DefaultState = false,
    WhileCooldown = 1,

    Parts = {
        { Type = "Dropdown", Name = "Units", Choices = GetUnitList(), Multiple = true },
        { Type = "Dropdown", Name = "Rarities", Choices = GetRarityList(), Multiple = true },
    },

    Setup = function()
        return {
            SellInventory = Network:WaitForChild("SellService"):WaitForChild("RF"):WaitForChild("SellInventory"),
            EntryRegistry = require(ReplicatedStorage.Framework.Features.Inventory.EntryRegistry),
        }
    end,

    WhileOn = function(s, values)
        local units = values.Units or {}
        local rarities = values.Rarities or {}
        if #units == 0 and #rarities == 0 then return end

        local inventory = DataController.Inventory()
        if type(inventory) ~= "table" then return end

        local toSell = {}
        for id, item in pairs(inventory) do
            if type(item) == "table" and item.name then
                local config = s.EntryRegistry.getEntryConfig(item.name)
                if config and config.kind == "Unit" then
                    local rarity = "Unknown"
                    if type(config.getRarity) == "function" then
                        rarity = config.getRarity(item.attributes)
                    elseif config.rarity then
                        rarity = config.rarity
                    end
                    if table.find(units, item.name) or table.find(rarities, tostring(rarity)) then
                        table.insert(toSell, id)
                    end
                end
            end
        end
        if #toSell > 0 then s.SellInventory:InvokeServer(toSell) end
    end,
})
