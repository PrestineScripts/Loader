PrestineLib:AddToggle({
    Tab = "Auto",
    MainName = "Auto Rebirth",
    Description = "Rebirths as soon as you can afford the next one",
    DefaultState = false,
    WhileCooldown = 1,
    Group = "Economy",
    Priority = 10,
    Setup = function()
        local s = {
            Remote = Network:WaitForChild("RebirthService"):WaitForChild("RE"):WaitForChild("Rebirth"),
            Rebirths = require(ReplicatedStorage.Framework.Features.Rebirth.Rebirths),
        }

        function s.GetCount()
            for _, name in ipairs({ "Rebirths", "Rebirth", "RebirthCount" }) do
                local fn = DataController[name]
                if type(fn) == "function" then
                    local ok, v = pcall(fn)
                    if ok and type(v) == "number" then return v end
                end
            end
        end

        function s.TryNow()
            local count = s.GetCount()
            if count == nil then
                s.Remote:FireServer()
                return false
            end
            local nextData = s.Rebirths.GetNext(count)
            if nextData and DataController.Money() >= nextData.cost then
                s.Remote:FireServer()
                return true
            end
            return false
        end

        return s
    end,
    WhileOn = function(s)
        return s.TryNow()
    end
})

