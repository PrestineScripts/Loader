        }
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d:IsA("ModuleScript") then
                local ok, result = pcall(require, d)
                if ok and type(result) == "table" and rawget(result, "GetAll") then
                    local okAll, all = pcall(result.GetAll)
                    if okAll and type(all) == "table" and all.Basic and all.Fire then
                        s.Dice = all
                        break
                    end
                end
            end
        end
        return s
    end,
    WhileOn = function(s)
        if not s.Dice then return end

        local money = DataController.Money()
        local best, bestPrice = nil, -1
        for name, info in pairs(s.Dice) do
            if type(info) == "table" then
                local price = info.price or 0
                if price <= money and price > bestPrice then
                    best, bestPrice = name, price
                end
            end
        end
        if best then s.BuyDice:FireServer(best) end
    end
})

