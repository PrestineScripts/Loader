local Network = ReplicatedStorage:WaitForChild("Network")
local DataController = require(ReplicatedStorage:WaitForChild("Framework"):WaitForChild("Features"):WaitForChild("Data"):WaitForChild("DataController"))

local function ScanUpgrades()
    local data, ids, seen = {}, {}, {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("ModuleScript") and d.Name:lower():find("upgrade") then
            local ok, result = pcall(require, d)
            if ok and type(result) == "table" then
                local list = result.entries or result.Entries or result.Upgrades or result.upgrades
                    or (rawget(result, "GetAll") and result.GetAll()) or result
                if type(list) == "table" then
                    for k, v in pairs(list) do
                        local id, price = nil, 0
                        if type(v) == "table" then
                            id = v.Id or v.id or v.Name or v.name or (type(k) == "string" and k)
                            price = v.price or v.Price or v.cost or v.Cost or 0
                        elseif type(k) == "string" then
                            id = k
                        end
                        if id then
                            local strId = tostring(id)
                            table.insert(data, { Id = strId, Price = tonumber(price) or 0 })
                            if not seen[strId] then
                                seen[strId] = true
                                table.insert(ids, strId)
                            end
                        end
                    end
                end
            end
        end
    end
    table.sort(ids)
    return data, ids
end

local function GetUnitList()
    local UnitConfig = require(ReplicatedStorage.Framework.Features.Inventory.Kinds.Unit.UnitConfig)
    local list = {}
    for name in pairs(UnitConfig.entries) do table.insert(list, name) end
    table.sort(list)
    return list
end

local function GetRarityList()
    local UnitConfig = require(ReplicatedStorage.Framework.Features.Inventory.Kinds.Unit.UnitConfig)
    local seen, list = {}, {}
    local function add(r)
        if r ~= nil and not seen[r] then
            seen[r] = true
            table.insert(list, tostring(r))
        end
    end
    local rarityTable = (type(UnitConfig.rarities) == "table" and UnitConfig.rarities)
        or (type(UnitConfig.Rarities) == "table" and UnitConfig.Rarities)
    if rarityTable then
        for r in pairs(rarityTable) do add(r) end
    end
    for _, u in pairs(UnitConfig.entries) do
        if type(u) == "table" then
            add(u.Rarity or u.rarity or u.RarityId or u.rarityId)
        end
    end
    table.sort(list)
    return list
end

